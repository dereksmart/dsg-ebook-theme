{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "paper",      "color": "#f3ecd8", "name": "Paper" },
				{ "slug": "paper-edge", "color": "#ebe2c8", "name": "Paper edge" },
				{ "slug": "ink",        "color": "#2a2620", "name": "Ink" },
				{ "slug": "ink-soft",   "color": "#5b5446", "name": "Soft ink" },
				{ "slug": "ink-faint",  "color": "#8a836f", "name": "Faint ink" },
				{ "slug": "rule",       "color": "#d3c9ad", "name": "Rule" },
				{ "slug": "highlight",  "color": "#e8c450", "name": "Highlight" },
				{ "slug": "bookmark",   "color": "#b0360b", "name": "Bookmark red" }
			],
			"defaultPalette": false,
			"defaultGradients": false,
			"customDuotone": false
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "Literata, 'Iowan Old Style', Georgia, serif",
					"slug": "serif",
					"name": "Literata"
				},
				{
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
					"slug": "mono",
					"name": "JetBrains Mono"
				}
			],
			"fontSizes": [
				{ "slug": "small",   "size": "16px", "name": "Small" },
				{ "slug": "medium",  "size": "18px", "name": "Medium" },
				{ "slug": "large",   "size": "20px", "name": "Large" },
				{ "slug": "x-large", "size": "22px", "name": "X-Large" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "920px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "18px",
			"lineHeight": "1.65",
			"letterSpacing": "0.005em"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "400"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(40px, 6vw, 72px)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.015em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(28px, 4vw, 40px)",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "22px",
					"lineHeight": "1.2"
				}
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic",
					"fontWeight": "400"
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--ink-soft)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--rule)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Top status bar", "area": "header" },
		{ "name": "footer", "title": "Bottom status bar", "area": "footer" }
	]
}

{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/essay-navigation",
	"version": "0.1.0",
	"title": "Essay Navigation",
	"category": "theme",
	"icon": "leftright",
	"description": "Render previous and next essay links in chapter order.",
	"textdomain": "dsg-ereader",
	"attributes": {
		"backLabel": {
			"type": "string",
			"default": "All essays"
		},
		"backHref": {
			"type": "string",
			"default": "/#essays"
		},
		"showBackLink": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": false,
		"align": false
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css"
}
